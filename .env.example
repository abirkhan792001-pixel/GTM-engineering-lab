# Copy to .env (git-ignored). Never commit real keys.

# Client profile: run on profiles/<name>/ (made by `npm run research -- <domain>`) instead
# of the template rules in src/context/. Leave empty for the template.
GTM_PROFILE=

# true (default): everything runs offline on mock providers.
# false: each integration below goes live if its settings are present, and falls back
# to its mock (with a startup warning) if not.
MOCK_MODE=true

# Qualification: Claude scoring (default model claude-sonnet-5). Paid per request.
ANTHROPIC_API_KEY=
# QUALIFIER_MODEL=claude-sonnet-5

# Qualification, free alternative: a local model served by Ollama (https://ollama.com).
# Run `ollama pull llama3.2` first. When set, it is used instead of Claude.
OLLAMA_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434

# Enrichment: live Firecrawl scrape when Apollo can't fill the required fields.
FIRECRAWL_API_KEY=

# Alerts: Slack incoming-webhook URL. Both #hot-leads and #manual-review alerts go to the
# webhook's channel, labelled with their route.
SLACK_WEBHOOK_URL=

# Resend. RESEND_FROM must be on a domain verified in Resend.
# - With DRAFT_REVIEW_EMAIL also set, each new draft is emailed to that inbox for review.
# - RESEND_API_KEY + RESEND_FROM send approved drafts to prospects (only after approval).
RESEND_API_KEY=
RESEND_FROM=
DRAFT_REVIEW_EMAIL=

# Bearer token for the draft approval endpoints (/api/drafts). At least 16 characters.
# Required in live mode: without it, approvals are disabled.
APPROVAL_TOKEN=

# CRM: placeholders. The CRM adapter is still a mock; these are not used yet.
ATTIO_API_KEY=
HUBSPOT_API_KEY=

# Webhook server (npm run server:dev).
PORT=3000
# Strongly recommended in live mode: callers must send it in the x-webhook-secret header.
WEBHOOK_SECRET=
