# Copy to .env (git-ignored). Never commit real keys.

# true (default): everything runs offline on mock providers.
# false: each integration below goes live if its settings are present, and falls back
# to its mock (with a startup warning) if not.
MOCK_MODE=true

# Qualification: Claude scoring (default model claude-sonnet-5).
ANTHROPIC_API_KEY=
# QUALIFIER_MODEL=claude-sonnet-5

# Enrichment: live Firecrawl scrape when Apollo can't fill the required fields.
FIRECRAWL_API_KEY=

# Alerts: Slack incoming-webhook URL. Both #hot-leads and #manual-review alerts go to the
# webhook's channel, labelled with their route.
SLACK_WEBHOOK_URL=

# Draft review: drafts are emailed to DRAFT_REVIEW_EMAIL for approval, never to prospects.
# RESEND_FROM must be on a domain verified in Resend. All three are needed.
RESEND_API_KEY=
RESEND_FROM=
DRAFT_REVIEW_EMAIL=

# CRM: placeholders. The CRM adapter is still a mock; these are not used yet.
ATTIO_API_KEY=
HUBSPOT_API_KEY=

# Webhook server (npm run server:dev).
PORT=3000
# Strongly recommended in live mode: callers must send it in the x-webhook-secret header.
WEBHOOK_SECRET=
